{
  "//": "Worked example: a pnpm/Expo monorepo with a Maestro E2E suite.",
  "//1": "Shows the three things that make a real project config non-trivial --",
  "//2": "a build whose env flags are inlined at bundle time (hence variants +",
  "//3": "kill_port), a detached dev server with a readiness probe, and a tool",
  "//4": "that needs its own JDK on PATH.",

  "listen": { "host": "192.168.64.1", "port": 8890 },

  "projects": [
    {
      "name": "my-expo-app",
      "root": "~/dev/my-expo-app",
      "guest_mount": "/workspace",

      "defaults": {
        "device": "iPhone 17 Pro",
        "bundle_id": "com.example.myapp",
        "workspace": "apps/mobile/ios/MyApp.xcworkspace",
        "scheme": "MyApp",
        "port": 8081
      },

      "//s": "Private simulators (`mac-sim sim create <name>`): a copy of the app",
      "//s1": "installed on the shared device, its own Metro port from port_base up,",
      "//s2": "the deep-link approval so openurl does not prompt, and RCT_jsLocation",
      "//s3": "in the GLOBAL domain so clearState flows keep loading from that port.",
      "simulators": {
        "max": 3,
        "port_base": 8090,
        "clone_app": true,
        "copy_prefs": ["com.apple.launchservices.schemeapproval.plist"],
        "global_defaults": { "RCT_jsLocation": "localhost:{port}" }
      },

      "//p": "Files `mac-sim pull <alias>` copies out of the app's data container.",
      "pull": {
        "db": "Documents/SQLite/myapp.db"
      },


      "//a": "The Android emulator (`mac-sim android ...`). A fixed console port",
      "//a1": "fixes its adb serial (emulator-5560) and keeps it off the 5554 an",
      "//a2": "emulator started by hand takes; -read-only lets both run one AVD.",
      "android": {
        "sdk": "~/Library/Android/sdk",
        "java_home": "/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home",
        "avd": "Pixel_8_API_35",
        "console_port": 5560,
        "port": 8097,
        "emulator_args": ["-no-window", "-no-audio", "-read-only", "-no-boot-anim"]
      },

      "commands": {
        "run": {
          "argv": ["pnpm", "--filter", "@myapp/mobile", "exec",
                   "expo", "run:ios", "--device", "{udid}", "--port", "{port}"],
          "cwd": "apps/mobile",
          "//": "expo run:ios never exits: once the app is launched it is the bundler.",
          "//1": "So it is detached, and done when the bundler answers AND the app runs.",
          "detach": true,
          "kill_port": "{port}",
          "ready_url": "http://localhost:{port}/status",
          "ready_match": "packager-status:running",
          "ready_app": true,
          "timeout": 2400,
          "path_prepend": ["~/.gem/ruby/4.0.0/bin"],
          "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
          "variants": {
            "e2e": {
              "env": { "EXPO_PUBLIC_E2E": "true" }
            },
            "demo": {
              "argv": ["pnpm", "--filter", "@myapp/mobile", "run",
                       "ios:demo", "--device", "{udid}", "--port", "{port}"],
              "env": { "EXPO_PUBLIC_E2E": "true", "EXPO_PUBLIC_DEMO_MODE": "true" }
            }
          }
        },

        "metro": {
          "argv": ["pnpm", "--filter", "@myapp/mobile", "exec",
                   "expo", "start", "--port", "{port}"],
          "cwd": "apps/mobile",
          "detach": true,
          "kill_port": "{port}",
          "ready_url": "http://localhost:{port}/status",
          "ready_match": "packager-status:running",
          "timeout": 120,
          "variants": {
            "e2e":  { "env": { "EXPO_PUBLIC_E2E": "true" } },
            "demo": { "env": { "EXPO_PUBLIC_E2E": "true", "EXPO_PUBLIC_DEMO_MODE": "true" } }
          }
        },

        "e2e": {
          "argv": ["~/.maestro/bin/maestro", "--device", "{udid}", "test", "{flow}"],
          "timeout": 3600,
          "path_prepend": ["/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home/bin"],
          "env": { "JAVA_HOME": "/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home" },
          "params": {
            "flow": { "path": true, "must_exist": true, "default": ".maestro" },
            "tags": { "pattern": "^[A-Za-z0-9_,-]{1,64}$", "default": "" }
          },
          "optional_argv": [
            { "when": "tags", "argv": ["--include-tags", "{tags}"] }
          ]
        },

        "android-run": {
          "//": "`mac-sim android run`: an android-* command runs on the emulator,",
          "//1": "under its claim, with {serial} {avd} {package} and the android {port}.",
          "platform": "android",
          "argv": ["pnpm", "--filter", "@myapp/mobile", "exec",
                   "expo", "run:android", "--device", "{avd}", "--port", "{port}"],
          "cwd": "apps/mobile",
          "detach": true,
          "kill_port": "{port}",
          "ready_url": "http://localhost:{port}/status",
          "ready_match": "packager-status:running",
          "ready_app": true,
          "timeout": 2400,
          "variants": { "e2e": { "env": { "EXPO_PUBLIC_E2E": "true" } } }
        },

        "android-build": {
          "//": "A release APK. private_tmp gives each variant its own TMPDIR, where",
          "//1": "Metro keeps a cache that ignores the EXPO_PUBLIC_* flags it inlines.",
          "platform": "android",
          "argv": ["./gradlew", "app:assembleRelease"],
          "cwd": "apps/mobile/android",
          "timeout": 5400,
          "private_tmp": true,
          "variants": { "e2e": { "env": { "EXPO_PUBLIC_E2E": "true" } } }
        },

        "android-e2e": {
          "platform": "android",
          "argv": ["~/.maestro/bin/maestro", "--device", "{serial}", "test", "{flow}"],
          "timeout": 3600,
          "params": {
            "flow": { "path": true, "must_exist": true, "default": ".maestro" },
            "tags": { "pattern": "^[A-Za-z0-9_,-]{1,64}$", "default": "" }
          },
          "optional_argv": [
            { "when": "tags", "argv": ["--include-tags", "{tags}"] }
          ]
        }
      }
    }
  ]
}
