#!/usr/bin/env python3
"""Guest-side CLI for the host's Xcode/simctl shim.

Xcode does not exist in this Linux container. This forwards a scoped set of
verbs to the shim running on the macOS host, which executes them there and
returns the output. Results that are files (screenshots, build products) land in
the bind-mounted workspace, so they are readable from in here.

Built-in simulator verbs work for any project:

  mac-sim list                          # available simulators
  mac-sim boot                          # default device; -d "iPhone 16" to change
  mac-sim install <path/to/App.app>
  mac-sim launch [bundle.id]            # --locale pl relaunches in that language
  mac-sim screenshot [out.png]          # must land inside the workspace
  mac-sim logs --last 5m --lines 300     # the app's own process; --all for
                                         # the whole simulator log
  mac-sim status                         # device, claim, bundler (and the build
                                         # profile it carries), app; exits 0
                                         # only when the app is ready to drive
  mac-sim pull <file> [out]             # copy a file out of the app's data
                                         # container (a declared alias, or a path
                                         # relative to it); a SQLite database
                                         # arrives as one consistent snapshot
  mac-sim openurl myapp://
  mac-sim browse https://example.com    # open a web page in the Mac's browser
  mac-sim appearance [light|dark]       # set, or print the current one
  mac-sim build                         # xcodebuild the project's workspace

Project commands come from the host config (`mac-sim commands` lists them):

  mac-sim commands                      # what this project declares
  mac-sim run                           # e.g. a declared "run" command
  mac-sim run --profile e2e             # ...in its "e2e" variant
  mac-sim metro start --profile e2e     # `<cmd> start` is the command itself
  mac-sim metro status                  # `<cmd> <sub>` -> the "metro-status" command
  mac-sim maestro --tags functional     # a declared parameter, as a flag
  mac-sim maestro .maestro/flows/x.yaml # ...or its one path parameter, bare

A project command prints its output as the host produces it, and keeps a copy in
.mac-sim/logs/<command>.log of the checkout; -q prints only the end. A command
that leaves a server running (a bundler, or a build that goes on to serve the
bundle) returns as soon as that server is ready and the app is up.

A project command's own parameters are real flags, taken from the host config, so
`mac-sim capture --help` lists what capture accepts. `--profile` names a variant
unless the command declares a parameter of that name. `-V` and `--arg key=value`
still work.

Everything runs in the checkout you call from, worktrees included: the CLI sends
its own checkout root and the host resolves paths from there. Because one Mac has
one simulator, one installed bundle id and one bundler port, a checkout claims
those while it uses them:

  mac-sim lock                          # who holds the simulator, and what
                                         # is executing right now, if anything
  mac-sim release                       # hand it back
  mac-sim reset                         # force-stop a stuck command and free
                                         # the lock (also: `mac-sim release -f`)
  mac-sim run -f                        # take it over from another checkout

A project that declares a "simulators" block can instead hand each checkout a
private simulator, with a copy of the installed app, its own bundler port and
its own claim, so two worktrees verify at the same time:

  mac-sim sim create mine               # name it; defaults to the checkout's name
  mac-sim --sim mine metro start        # every command takes --sim
  mac-sim --sim mine screenshot
  mac-sim sim list
  mac-sim sim delete mine               # also stops its bundler

A project that declares an "android" block also drives an Android emulator on
the Mac, under a claim of its own (it never contends with the iOS simulator):

  mac-sim android list                  # AVDs and attached adb devices
  mac-sim android boot                  # the project's AVD, headless; waits for boot
  mac-sim android install path/to/app.apk
  mac-sim android launch [--locale pl]  # terminate | uninstall too
  mac-sim android screenshot [out.png]
  mac-sim android openurl myapp://
  mac-sim android appearance [light|dark]
  mac-sim android logs --lines 300      # the app's own pid; --all for everything
  mac-sim android status                # emulator, claim, bundler, app; exit 0 = ready
  mac-sim android lock | release | reset
  mac-sim android shutdown
  mac-sim android run --profile e2e     # any other word is the declared
                                         # "android-run" project command
  mac-sim android -d tablet boot        # another emulator the project declares
"""

import argparse
import json
import os
import sys
import threading
import time
import urllib.error
import urllib.request

SHIM = os.environ.get("MAC_SIM_SHIM", "http://192.168.64.1:8890")
TOKEN = os.environ.get("MAC_SIM_TOKEN", "")
DEVICE = os.environ.get("MAC_SIM_DEVICE")
SIM = os.environ.get("MAC_SIM_SIM")
ANDROID_DEVICE = os.environ.get("MAC_SIM_ANDROID_DEVICE")

BUILTINS = {"list", "booted", "runtimes", "boot", "shutdown", "gui", "install",
            "launch", "terminate", "uninstall", "openurl", "appearance", "screenshot", "logs",
            "build", "commands", "lock", "release", "reset", "sim", "pull", "status",
            "android", "browse"}

# `mac-sim android <verb>`: built in. Any other word after `android` is the
# project command `android-<word>`.
ANDROID_BUILTINS = {"list", "boot", "shutdown", "install", "uninstall", "launch",
                    "terminate", "screenshot", "openurl", "appearance", "logs",
                    "status", "lock", "release", "reset"}

# Distinct from a general host-command failure (which exits with the shim's own
# exit_code, normally the exact status the failing command returned). A 409
# ("another mac-sim command is running") is specifically retryable, so it gets
# EX_TEMPFAIL rather than the generic 1: a caller scripting `mac-sim ... ; $?`
# can tell "try again later" apart from "this is actually broken."
EX_TEMPFAIL = 75

# Options that consume the next argument. Needed to find the subcommand: without
# it `mac-sim -d "iPhone 16" boot` reads the device name as the subcommand and
# forwards it to the host as an undeclared project command.
VALUE_OPTS = {"-d", "--device", "-p", "--project", "-w", "--workdir",
              "-V", "--variant", "--arg", "--last", "--lines", "--predicate",
              "--workspace", "--scheme", "--configuration", "--sim", "--locale",
              "--pid"}

# The host shim is a long-running process: an edit to it reaches nothing until
# it is restarted, while this CLI is re-read on every call. So this file can be
# newer than the shim it talks to.
STALE_SHIM = ("the host shim is older than this CLI and does not support {what}.\n"
              "On the Mac, restart it:  cc-sim-down && cc-sim-up")


# The subset every command accepts, wherever it is written.
COMMON_VALUE_OPTS = {"-d", "--device", "-p", "--project", "-w", "--workdir", "--sim"}


def checkout_root(start=None):
    """The nearest ancestor holding a .git entry, or None.

    A git worktree's .git is a FILE rather than a directory, which is exactly the
    case this exists for: a session started with `ccx --worktree <name>` lives in
    <project>/.claude/worktrees/<name>, and the host must act on that checkout
    rather than on the main one.
    """
    path = os.path.abspath(start or os.getcwd())
    while True:
        if os.path.exists(os.path.join(path, ".git")):
            return path
        parent = os.path.dirname(path)
        if parent == path:
            return None
        path = parent


WORKDIR = os.environ.get("MAC_SIM_WORKDIR") or checkout_root()

UNREACHABLE = (
    "mac-sim: cannot reach the host shim at {shim} ({reason}).\n"
    "The shim runs on macOS and cannot be started from in here.\n"
    "On the Mac, run:  cc-sim-up\n"
    "It starts automatically for directories inside a project root declared in\n"
    "~/.config/cc-container/mac-sim.json; this workspace may be outside them."
)


def request(method, payload=None, timeout=3700):
    # The proxy (when there is one) is for outbound internet; the shim is a
    # direct host call and must not be proxied.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    headers = {"Content-Type": "application/json", "X-Mac-Sim-Token": TOKEN}
    url = SHIM + ("/health" if method == "GET" else "")
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with opener.open(req, timeout=timeout) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        if exc.code == 401:
            sys.exit("mac-sim: the shim rejected this container's token. "
                     "Recycle the session on the Mac (cc-down && cc-up).")
        # The shim's refusals are multi-line and meant to be acted on; printing
        # the raw JSON turns them into one escaped line nobody reads.
        try:
            detail = json.loads(detail)["error"]
        except (ValueError, KeyError, TypeError):
            pass
        if exc.code == 400 and detail.startswith("verb must be one of"):
            sys.exit("mac-sim: " + STALE_SHIM.format(
                what=f"`{(payload or {}).get('verb')}`"))
        if exc.code == 409:
            print(f"mac-sim: {detail}", file=sys.stderr)
            sys.exit(EX_TEMPFAIL)
        sys.exit(f"mac-sim: shim rejected the request (HTTP {exc.code}): {detail}")
    except urllib.error.URLError as exc:
        sys.exit(UNREACHABLE.format(shim=SHIM, reason=exc.reason))


def call(payload, timeout=3700):
    return call_following(payload, None, follow=False, timeout=timeout)[0]


def log_signature(path):
    try:
        st = os.stat(path)
    except OSError:
        return None
    return st.st_ino, st.st_size, st.st_mtime_ns


# A request still waiting after this many seconds gets a status line, so a
# quiet host step (an xcodebuild link, a cold emulator boot) does not look hung.
PROGRESS_AFTER = 3
SPINNER = "|/-\\"


def elapsed(seconds):
    m, s = divmod(int(seconds), 60)
    return f"{m}m{s:02d}s" if m else f"{s}s"


class Progress:
    """One self-rewriting status line on stderr while a request waits.

    Drawn only when stderr is a terminal: captured stderr (a script's
    subprocess call, an agent's Bash tool) gets nothing, so whatever parses it
    sees what it always did. It is erased before streamed output is written and
    never drawn over a line that output left unfinished.
    """

    def __init__(self, label):
        self.label = label
        self.enabled = sys.stderr.isatty()
        self.start = self.last_output = time.monotonic()
        self.streamed = self.shown = self.line_open = False
        self.ticks = 0

    def output(self, chunk):
        self.clear()
        sys.stdout.buffer.write(chunk)
        sys.stdout.flush()
        self.last_output = time.monotonic()
        self.streamed = True
        self.line_open = not chunk.endswith(b"\n")

    def draw(self):
        now = time.monotonic()
        if not self.enabled or self.line_open or now - self.last_output < PROGRESS_AFTER:
            return
        text = f"{SPINNER[self.ticks % len(SPINNER)]} mac-sim {self.label}: waiting for the host, {elapsed(now - self.start)}"
        if self.streamed:
            text += f", no new output for {elapsed(now - self.last_output)}"
        sys.stderr.write("\r\033[K" + text)
        sys.stderr.flush()
        self.shown = True
        self.ticks += 1

    def clear(self):
        if self.shown:
            sys.stderr.write("\r\033[K")
            sys.stderr.flush()
            self.shown = False


def call_following(payload, log_path, follow, timeout=3700):
    """Send a request and wait for it under a Progress line, meanwhile copying
    the host's live log of it to stdout when `follow` is set. Returns
    (result, followed).

    The host replaces the log when the command starts, so nothing is printed
    until the file differs from what was there before the request: otherwise
    the previous run's output would be replayed as this one's.
    """
    before = log_signature(log_path) if follow else None
    box = {}

    def post():
        try:
            box["result"] = request("POST", payload, timeout)
        except SystemExit as exc:
            box["exit"] = exc

    thread = threading.Thread(target=post, daemon=True)
    thread.start()
    progress = Progress(payload.get("command") or payload.get("verb"))
    log = None
    try:
        while True:
            thread.join(0.5)
            finished = not thread.is_alive()
            if follow and log is None and log_signature(log_path) not in (None, before):
                log = open(log_path, "rb")
            if log:
                chunk = log.read()
                if chunk:
                    progress.output(chunk)
            if finished:
                break
            progress.draw()
    finally:
        progress.clear()
        # The host's last line may lack its newline (pnpm ends on padding),
        # which would start mac-sim's own verdict partway along it.
        if progress.line_open:
            sys.stdout.buffer.write(b"\n")
            sys.stdout.flush()
        if log:
            log.close()
    if "exit" in box:
        raise box["exit"]
    return box["result"], log is not None


def require_feature(feature, what, health=None):
    """Refuse to send a field an older shim would silently ignore: `--sim x`
    dropped on the floor is a command run against the SHARED simulator."""
    health = health or request("GET", timeout=30)
    if feature not in health.get("features", []):
        sys.exit("mac-sim: " + STALE_SHIM.format(what=what))
    return health


def emit(result, quiet_stdout=False):
    """Print a shim result and exit non-zero if the host command failed."""
    if result.get("stdout") and not quiet_stdout:
        print(result["stdout"])
    if result.get("stderr"):
        print(result["stderr"], file=sys.stderr)
    code = result.get("exit_code", 0)
    if code != 0:
        sys.exit(f"mac-sim: {result.get('verb')} failed on the host "
                 f"(exit {code}); see output above")
    return result


def pretty_devices(raw):
    for runtime, devices in sorted(json.loads(raw).get("devices", {}).items()):
        avail = [d for d in devices if d.get("isAvailable")]
        if not avail:
            continue
        print(runtime.rsplit(".", 1)[-1])
        for d in avail:
            print(f"  {d['state']:<10} {d['name']}  ({d['udid']})")


def guest_abspath(raw):
    """Absolutize before sending: the shim resolves paths on the host, so a
    relative path would resolve against the host's cwd, not the caller's.

    /workspace is a guest-only symlink to the project's host-path mount (see
    cc-workspace-link), so it is resolved here; the host has no such path."""
    path = raw if os.path.isabs(raw) else os.path.abspath(raw)
    if path == "/workspace" or path.startswith("/workspace/"):
        path = os.path.realpath("/workspace") + path[len("/workspace"):]
    return path


def print_commands(health):
    print(f"checkout: {WORKDIR or 'unknown (not in a git checkout)'}")
    for name, project in health.get("projects", {}).items():
        print(f"{name}  ({project['root']})")
        owner = project.get("owner")
        if owner:
            mine = " (this checkout)" if owner.get("workdir") == WORKDIR else ""
            held_by = owner.get("guest_workdir") or owner.get("workdir")
            print(f"  simulator held by: {held_by}{mine}")
        executing = project.get("executing")
        if executing:
            mins, secs = divmod(int(executing.get("elapsed", 0)), 60)
            print(f"  EXECUTING NOW: {executing.get('verb')!r} "
                 f"(pid {executing.get('pid') or 'starting'}, {mins}m {secs}s) "
                 f"-- `mac-sim reset` to force-stop it")
            if executing.get("log"):
                print(f"  live output: {executing['log']}")
        android = project.get("android")
        if android:
            print(f"  android emulators (`mac-sim android [-d NAME] ...`), "
                  f"package {android['package']}:")
            for dname, device in sorted(android["devices"].items()):
                owner = device.get("owner")
                held = (f", held by {owner.get('guest_workdir') or owner.get('workdir')}"
                        if owner else "")
                default = " (default)" if dname == android["default"] else ""
                print(f"    {dname}{default}: {device['avd']} as {device['serial']}, "
                      f"bundler port {device.get('port')}{held}")
        sims = project.get("simulators")
        if sims is not None:
            print("  private simulators: " + (", ".join(
                f"{sname} (port {entry.get('port')})" for sname, entry in sorted(sims.items()))
                or "none yet (`mac-sim sim create <name>`)"))
        if project.get("pull"):
            print("  pull aliases: " + ", ".join(
                f"{alias} ({path})" for alias, path in sorted(project["pull"].items())))
        defaults = project.get("defaults") or {}
        if defaults:
            print("  defaults: " + ", ".join(f"{k}={v}" for k, v in sorted(defaults.items())))
        if not project["commands"]:
            print("  (no project commands declared)")
        for cname, spec in sorted(project["commands"].items()):
            bits = []
            if spec.get("platform") == "android":
                bits.append(f"android: `mac-sim android {cname[len('android-'):]}`"
                            if cname.startswith("android-") else "android")
            if spec["variants"]:
                bits.append("variants: " + "|".join(spec["variants"]))
            if spec["params"]:
                bits.append("args: " + ", ".join(sorted(spec["params"])))
            print(f"  {cname:<20}{('  ' + '; '.join(bits)) if bits else ''}")


def first_positional(argv):
    """(value, index) of the first argument that is a subcommand, not an option
    or an option's value."""
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg.startswith("--") and "=" in arg:
            i += 1
        elif arg in VALUE_OPTS:
            i += 2
        elif arg.startswith("-"):
            i += 1
        else:
            return arg, i
    return None, -1


def kv(raw):
    if "=" not in raw:
        raise argparse.ArgumentTypeError("--arg expects key=value")
    key, _, value = raw.partition("=")
    return key, value


def preflight_project(argv):
    """-p/--project, read before the real parse: the command's own flags are
    built from the host's declarations, and those are per project."""
    for i, arg in enumerate(argv):
        if arg in ("-p", "--project") and i + 1 < len(argv):
            return argv[i + 1]
        if arg.startswith("--project="):
            return arg.split("=", 1)[1]
    return None


def declared_commands(health, project_name):
    projects = health.get("projects", {})
    if project_name:
        if project_name not in projects:
            sys.exit(f"mac-sim: unknown project {project_name!r}; declared: "
                     f"{', '.join(sorted(projects)) or 'none'}")
        return projects[project_name]["commands"]
    if len(projects) == 1:
        return next(iter(projects.values()))["commands"]
    # Several projects and no -p: merge, and let the shim raise the ambiguity.
    return {name: spec for p in projects.values()
            for name, spec in p["commands"].items()}


def resolve_command(commands, name, rest):
    """Map `<cmd> [<sub>]` onto a declared command, returning (name, rest).

    `metro status` -> the "metro-status" command and `metro start` -> "metro"
    read better than hyphenated names, and are the forms the project's own docs
    and agent definitions already use. A leftover positional becomes the
    command's path parameter when it has exactly one, so a flow file can be named
    directly instead of as --flow.
    """
    def known(resolved, tail):
        if resolved not in commands:
            sys.exit(f"mac-sim: no command {resolved!r}; declared: "
                     f"{', '.join(sorted(commands)) or 'none'}")
        return resolved, tail

    # Options given before the command (`mac-sim --sim x metro status`) sit in
    # front of the subcommand here; step over them to find it.
    lead = 0
    while lead < len(rest):
        if rest[lead] in COMMON_VALUE_OPTS:
            lead += 2
        elif rest[lead] in ("-f", "--force"):
            lead += 1
        else:
            break
    head, rest = rest[:lead], rest[lead:]
    if not rest or rest[0].startswith("-"):
        return known(name, head + rest)
    sub_name, tail = rest[0], head + rest[1:]
    if f"{name}-{sub_name}" in commands:
        return f"{name}-{sub_name}", tail
    if sub_name == "start" and name in commands:
        return name, tail
    known(name, tail)  # an unknown command must say so before blaming its args
    paths = [p for p, spec in commands.get(name, {}).get("params", {}).items()
             if spec.get("path")]
    if len(paths) == 1:
        return known(name, [f"--{paths[0]}", sub_name] + tail)
    subs = sorted(c[len(name) + 1:] for c in commands if c.startswith(f"{name}-"))
    sys.exit(f"mac-sim {name}: unexpected argument {sub_name!r}. "
             + (f"Subcommands: {', '.join(['start'] + subs)}." if subs else
                f"Pass parameters as flags; see `mac-sim {name} --help`."))


def command_parser(name, spec, common):
    """A parser carrying the command's declared parameters as real flags, so
    --help is accurate and an undeclared flag fails here rather than on the Mac."""
    params, variants = spec.get("params", {}), sorted(spec.get("variants", []))
    pc = argparse.ArgumentParser(prog=f"mac-sim {name}", parents=[common])
    pc.add_argument("-V", "--variant", default=None,
                    choices=variants or None, help="build profile")
    pc.add_argument("--arg", type=kv, action="append", default=[],
                    metavar="KEY=VALUE", help="declared parameter (legacy form)")
    for param in sorted(params):
        pc.add_argument(f"--{param}", default=None, dest=f"param_{param}",
                        metavar=param.upper(), help="declared parameter")
    pc.add_argument("-q", "--quiet", action="store_true",
                    help="do not print the output as it is produced, only its end")
    # --profile is the variant, except where the command declares a parameter of
    # that name (a capture profile is a dataset, not a build flag).
    if "profile" not in params and variants:
        pc.add_argument("--profile", dest="variant", choices=variants,
                        help="alias for --variant")
    return pc, params


def scope_of(a):
    """The fields every request carries: which project, which checkout, which
    device, and whether to take the simulator over."""
    scope = {}
    if a.sim:
        if a.device and a.device != DEVICE:
            sys.exit("mac-sim: --sim names the device already; drop -d/--device")
        scope["sim"] = a.sim
    elif a.device:
        scope["device"] = a.device
    if a.project:
        scope["project"] = a.project
    if a.workdir:
        scope["workdir"] = guest_abspath(a.workdir)
    if a.force:
        scope["force"] = True
    return scope


def android_main(sub, argv):
    """`mac-sim android <verb>`: the built-ins, sent with platform "android"."""
    ap = argparse.ArgumentParser(prog=f"mac-sim android {sub}")
    ap.add_argument("-d", "--device", default=ANDROID_DEVICE, metavar="NAME",
                    help="an emulator the project declares (default: its default one)")
    ap.add_argument("-p", "--project", default=None,
                    help="project name (only needed if several are configured)")
    ap.add_argument("-w", "--workdir", default=WORKDIR,
                    help="checkout to act on (default: the one you are in)")
    ap.add_argument("-f", "--force", action="store_true",
                    help="take the emulator over from another checkout")
    if sub == "install":
        ap.add_argument("apk")
    elif sub in ("launch", "terminate", "uninstall"):
        ap.add_argument("package", nargs="?")
        if sub == "launch":
            ap.add_argument("--locale", default=None, metavar="LANG",
                            help="relaunch the app in this language, e.g. pl or pl-PL "
                                 "(a per-app locale, Android 13+)")
    elif sub == "openurl":
        ap.add_argument("url")
    elif sub == "appearance":
        ap.add_argument("mode", nargs="?", choices=["light", "dark"])
    elif sub == "screenshot":
        ap.add_argument("out", nargs="?", default=None)
    elif sub == "logs":
        ap.add_argument("--lines", type=int, default=200)
        ap.add_argument("--all", action="store_true",
                        help="the whole logcat buffer, not only the app's pid")
    elif sub == "reset":
        ap.add_argument("--pid", type=int, default=None,
                        help="only reset if this pid is still the one executing")
    a = ap.parse_args(argv)

    health = require_feature("android", "`mac-sim android`")
    scope = {"platform": "android"}
    if a.device:
        require_feature("android_devices", "`mac-sim android -d`", health)
        scope["android_device"] = a.device
    if a.project:
        scope["project"] = a.project
    if a.workdir:
        scope["workdir"] = guest_abspath(a.workdir)
    if a.force:
        scope["force"] = True

    if sub in ("lock", "release", "reset"):
        payload = {"verb": "lock", **scope}
        if sub == "reset" or (sub == "release" and a.force):
            payload["action"] = "reset"
            if getattr(a, "pid", None):
                payload["pid"] = a.pid
        elif sub == "release":
            payload["action"] = "release"
        return emit(call(payload, timeout=30))

    if sub == "status":
        res = emit(call({"verb": "status", **scope}, timeout=120))
        sys.exit(0 if res.get("ready") else 1)

    if sub == "boot":
        print("mac-sim android boot: starting the emulator; a cold boot takes a "
              "minute or two", file=sys.stderr)
        res = emit(call({"verb": "boot", **scope}), quiet_stdout=True)
        print("already booted" if "already booted" in res.get("stdout", "") else "booted")
        if res.get("log"):
            print(f"emulator output: {res['log']}", file=sys.stderr)
        return

    if sub == "screenshot":
        local = guest_abspath(
            a.out or os.path.join(a.workdir or "/workspace", ".mac-sim/android.png"))
        res = emit(call({"verb": "screenshot", "out": local, **scope}), quiet_stdout=True)
        if not os.path.exists(local):
            sys.exit(f"mac-sim: the host wrote {res.get('path')} but it is not "
                     f"visible at {local}; is that path inside the bind mount?")
        print(f"{local} ({os.path.getsize(local)} bytes)")
        return

    payload = {"verb": sub, **scope}
    if sub == "install":
        payload["app"] = guest_abspath(a.apk)
    elif sub in ("launch", "terminate", "uninstall") and a.package:
        payload["bundle_id"] = a.package
    if getattr(a, "locale", None):
        payload["locale"] = a.locale
    if sub == "openurl":
        payload["url"] = a.url
    if sub == "appearance" and a.mode:
        payload["mode"] = a.mode
    if sub == "logs":
        payload["lines"] = a.lines
        if a.all:
            payload["all"] = True
    res = emit(call(payload))
    if sub in ("shutdown", "install", "uninstall", "launch", "terminate", "openurl") \
            or (sub == "appearance" and a.mode):
        print(f"android {sub}: done")


def main():
    def common_options(nested):
        """The options every command takes. A nested parser must not carry
        defaults: argparse lets a subparser's default overwrite the value the
        parent parser already read, so `mac-sim --sim x boot` would lose its
        --sim and boot the shared simulator instead."""
        def default(value):
            return argparse.SUPPRESS if nested else value
        parser = argparse.ArgumentParser(add_help=False)
        parser.add_argument("-d", "--device", default=default(DEVICE),
                            help="simulator name (default: the project's)")
        parser.add_argument("--sim", default=default(SIM), metavar="NAME",
                            help="a private simulator from `mac-sim sim create` "
                                 "(default: the shared one)")
        parser.add_argument("-p", "--project", default=default(None),
                            help="project name (only needed if several are configured)")
        parser.add_argument("-w", "--workdir", default=default(WORKDIR),
                            help="checkout to act on (default: the one you are in)")
        parser.add_argument("-f", "--force", action="store_true", default=default(False),
                            help="take the simulator over from another checkout")
        return parser

    common, nested = common_options(False), common_options(True)
    ap = argparse.ArgumentParser(
        prog="mac-sim", description=__doc__, parents=[common],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name):
        return sub.add_parser(name, parents=[nested])

    for name in ("list", "booted", "runtimes", "boot", "shutdown", "gui",
                 "commands", "lock", "release", "status"):
        add(name)
    p = add("reset")
    p.add_argument("--pid", type=int, default=None,
                    help="only reset if this pid is still the one executing "
                         "(from `mac-sim lock`); guards against killing an "
                         "unrelated command that started after you looked. "
                         "Omit to reset whatever is current.")
    p = add("install"); p.add_argument("app")
    for name in ("launch", "terminate", "uninstall"):
        p = add(name); p.add_argument("bundle_id", nargs="?")
        if name == "launch":
            p.add_argument("--locale", default=None, metavar="LANG",
                           help="relaunch the app in this language, e.g. pl or pl-PL")
    p = add("pull")
    p.add_argument("path", help="a pull alias the project declares, or a path "
                                "relative to the app's data container")
    p.add_argument("out", nargs="?", default=None,
                   help="where to write it (default: .mac-sim/<file name>)")
    p.add_argument("--bundle-id", default=None)
    p = add("sim")
    sims = p.add_subparsers(dest="sim_cmd", required=True)
    sp = sims.add_parser("create", parents=[nested])
    sp.add_argument("name", nargs="?", default=None,
                    help="default: the checkout directory's name")
    sp = sims.add_parser("delete", parents=[nested]); sp.add_argument("name")
    sims.add_parser("list", parents=[nested])
    p = add("openurl"); p.add_argument("url")
    p = add("browse"); p.add_argument("url", help="an http:// or https:// URL")
    p = add("appearance"); p.add_argument("mode", nargs="?", choices=["light", "dark"])
    p = add("screenshot"); p.add_argument("out", nargs="?", default=None)
    p = add("logs")
    p.add_argument("--last", default="2m")
    p.add_argument("--lines", type=int, default=200)
    p.add_argument("--predicate")
    p.add_argument("--all", action="store_true",
                   help="the whole simulator log, not only the app's process")
    p = add("build")
    p.add_argument("--workspace")
    p.add_argument("--scheme")
    p.add_argument("--configuration", default="Debug", choices=["Debug", "Release"])

    # Any subcommand that is not built in is a project command declared in the
    # host config. Parse those generically rather than hardcoding one project's
    # verbs into this CLI.
    argv = sys.argv[1:]
    first, idx = first_positional(argv)
    android_prefix = first == "android"
    if android_prefix:
        rest = argv[:idx] + argv[idx + 1:]
        sub, sidx = first_positional(rest)
        if sub is None or sub in ("-h", "--help"):
            sys.exit("usage: mac-sim android <" + "|".join(sorted(ANDROID_BUILTINS))
                     + "|<declared android-* command>> ...")
        if sub in ANDROID_BUILTINS:
            return android_main(sub, rest[:sidx] + rest[sidx + 1:])
        # `android run` is the declared "android-run"; the project command path
        # below then resolves it like any other (`android metro status` included).
        argv = rest[:sidx] + [f"android-{sub}"] + rest[sidx + 1:]
        first, idx = f"android-{sub}", sidx
    if first is not None and first not in BUILTINS:
        # Drop the subcommand by position: dropping every argument equal to it
        # would also eat an option value that happened to match.
        rest = argv[:idx] + argv[idx + 1:]
        health = request("GET", timeout=30)
        commands = declared_commands(health, preflight_project(argv))
        name, rest = resolve_command(commands, first, rest)
        pc, params = command_parser(name, commands.get(name, {}), common)
        a = pc.parse_args(rest)
        # MAC_SIM_SIM names this checkout's private iOS simulator; an Android
        # command never runs on it, so only an explicit --sim reaches the shim
        # (which refuses it).
        android = android_prefix or commands.get(name, {}).get("platform") == "android"
        if android and a.sim == SIM and not any(
                arg == "--sim" or arg.startswith("--sim=") for arg in rest):
            a.sim = None
        if a.sim:
            require_feature("sim", "--sim", health)
        args = dict(a.arg)
        args.update({p: v for p in params
                     if (v := getattr(a, f"param_{p}", None)) is not None})
        payload = {"verb": "project_command", "command": name,
                   "args": args, **scope_of(a)}
        if a.variant:
            payload["variant"] = a.variant
        log_stem = f"{name}@{a.sim}" if a.sim else name
        # After `android`, -d names an emulator, not an iOS simulator.
        android_device = payload.pop("device", None) if android_prefix else None
        if android_device == DEVICE:  # MAC_SIM_DEVICE, the iOS default, not a choice
            android_device = None
        android_device = android_device or (ANDROID_DEVICE if android_prefix else None)
        if android_device:
            require_feature("android_devices", "`mac-sim android -d`", health)
            payload["android_device"] = android_device
            for project in health.get("projects", {}).values():
                if (project.get("android") or {}).get("default") not in (None, android_device):
                    log_stem = f"{name}@{android_device}"
        log_path = a.workdir and os.path.join(a.workdir, ".mac-sim", "logs", f"{log_stem}.log")
        # These run for minutes; say which checkout is being built before the
        # wait starts, so a wrong-worktree call is caught then and not after.
        print(f"mac-sim {name}: {a.workdir or 'project root'}", file=sys.stderr)
        result, followed = call_following(payload, log_path,
                                          follow=bool(log_path) and not a.quiet)
        if result.get("stdout_is_log") and a.quiet:
            result["stdout"] = "\n".join(result["stdout"].splitlines()[-40:])
        if result.get("log"):
            print(f"mac-sim {name}: full output in {result['log']}", file=sys.stderr)
        return emit(result, quiet_stdout=followed and result.get("stdout_is_log", False))

    a = ap.parse_args()

    if a.cmd == "sim":
        payload = {"verb": f"sim_{a.sim_cmd}"}
        if a.project:
            payload["project"] = a.project
        if a.workdir:
            payload["workdir"] = guest_abspath(a.workdir)
        if a.force:
            payload["force"] = True
        if a.sim_cmd != "list":
            name = a.name or os.path.basename(a.workdir or "")
            if not name:
                sys.exit("mac-sim sim: give the simulator a name")
            payload["name"] = name
        if a.sim_cmd == "create":
            print(f"mac-sim sim create {payload['name']}: creating and booting a "
                  f"simulator, about a minute", file=sys.stderr)
        return emit(call(payload))

    scope = scope_of(a)
    if "sim" in scope:
        require_feature("sim", "--sim")

    if a.cmd == "commands":
        return print_commands(request("GET", timeout=30))

    if a.cmd in ("lock", "release", "reset"):
        payload = {"verb": "lock", **scope}
        if a.cmd == "reset" or (a.cmd == "release" and a.force):
            payload["action"] = "reset"
            if getattr(a, "pid", None):
                payload["pid"] = a.pid
        elif a.cmd == "release":
            payload["action"] = "release"
        return emit(call(payload, timeout=30))

    if a.cmd == "status":
        res = emit(call({"verb": "status", **scope}, timeout=120))
        sys.exit(0 if res.get("ready") else 1)

    if a.cmd in ("list", "booted", "runtimes"):
        res = call({"verb": a.cmd})
        if res.get("exit_code"):
            emit(res)
        if a.cmd == "runtimes":
            print(res["stdout"])
        else:
            pretty_devices(res["stdout"])
        return

    if a.cmd == "gui":
        return emit(call({"verb": "open_simulator_ui"}))

    if a.cmd == "browse":
        require_feature("browse", "browse")
        emit(call({"verb": "browse", "url": a.url}))
        print(f"opened {a.url} on the Mac")
        return

    if a.cmd in ("boot", "shutdown"):
        res = call({"verb": a.cmd, **scope})
        # Re-booting an already-booted device is not an error worth failing on.
        if res.get("exit_code") and "current state: Booted" in res.get("stderr", ""):
            print("already booted")
            return
        emit(res)
        print("booted" if a.cmd == "boot" else "shut down")
        return

    if a.cmd == "install":
        res = emit(call({"verb": "install", "app": guest_abspath(a.app), **scope}))
        print(f"installed {res.get('bundle_id') or a.app}")
        return

    if a.cmd in ("launch", "terminate", "uninstall"):
        payload = {"verb": a.cmd, **scope}
        if a.bundle_id:
            payload["bundle_id"] = a.bundle_id
        locale = getattr(a, "locale", None)
        if locale:
            require_feature("locale", "launch --locale")
            payload["locale"] = locale
        emit(call(payload))
        print(f"{a.cmd}: {a.bundle_id or 'default bundle'}"
              + (f" (language {locale})" if locale else ""))
        return

    if a.cmd == "pull":
        out = a.out
        if not out:
            # An alias names a file the host config knows; keep its real name.
            aliases = {}
            for project in request("GET", timeout=30).get("projects", {}).values():
                aliases.update(project.get("pull") or {})
            out = os.path.join(a.workdir or "/workspace", ".mac-sim",
                               os.path.basename(aliases.get(a.path, a.path)))
        out = guest_abspath(out)
        payload = {"verb": "pull", "path": a.path, "out": out, **scope}
        if a.bundle_id:
            payload["bundle_id"] = a.bundle_id
        res = emit(call(payload), quiet_stdout=True)
        if not os.path.exists(out):
            sys.exit(f"mac-sim: the host wrote {res.get('path')} but it is not "
                     f"visible at {out}; is that path inside the bind mount?")
        print(f"{out} ({os.path.getsize(out)} bytes)")
        return

    if a.cmd == "openurl":
        emit(call({"verb": "openurl", "url": a.url, **scope}))
        print(f"opened {a.url}")
        return

    if a.cmd == "appearance":
        payload = {"verb": "appearance", **scope}
        if a.mode:
            payload["mode"] = a.mode
        res = emit(call(payload), quiet_stdout=not a.mode)
        print(f"appearance: {a.mode}" if a.mode else res["stdout"].strip())
        return

    if a.cmd == "screenshot":
        local = guest_abspath(
            a.out or os.path.join(a.workdir or "/workspace", ".mac-sim/screenshot.png"))
        res = emit(call({"verb": "screenshot", "out": local, **scope}),
                   quiet_stdout=True)
        if not os.path.exists(local):
            sys.exit(f"mac-sim: the host wrote {res.get('path')} but it is not "
                     f"visible at {local}; is that path inside the bind mount?")
        print(f"{local} ({os.path.getsize(local)} bytes)")
        return

    if a.cmd == "logs":
        payload = {"verb": "logs", "last": a.last, "lines": a.lines, **scope}
        if a.predicate:
            payload["predicate"] = a.predicate
        elif a.all:
            payload["all"] = True
        return emit(call(payload))

    if a.cmd == "build":
        payload = {"verb": "xcodebuild", "configuration": a.configuration, **scope}
        if a.workspace:
            payload["workspace"] = guest_abspath(a.workspace)
        if a.scheme:
            payload["scheme"] = a.scheme
        return emit(call(payload))


if __name__ == "__main__":
    main()
