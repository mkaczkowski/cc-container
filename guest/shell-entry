#!/bin/sh
# Entrypoint for one-off container shells (cc-shell): links /workspace to the
# project mount (see cc-workspace-link), installs the Mac's terminfo entry if
# the guest lacks it (see cc-terminfo-sync), then hands off to bash.
set -e
/opt/cc-tools/cc-workspace-link
/opt/cc-tools/cc-terminfo-sync
exec /bin/bash "$@"
