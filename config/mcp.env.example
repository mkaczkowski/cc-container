# Secrets referenced as ${VAR} from mcp-servers.json.
# Copy to ~/.config/cc-container/mcp.env and chmod 600.
# Values reach the guest as --env and are then substituted into the guest's
# ~/.claude.json by cc-mcp-sync, which is what makes `claude mcp list` and /mcp
# work. So the resolved secret DOES persist, in the cc-home volume, until you
# delete that volume. What this file buys you is that the secret is not in a
# JSON file you might commit, share, or copy between machines -- not that it
# stays out of the container. Treat cc-home as holding your keys.
CONTEXT7_API_KEY=your-key-here
