# Local, user-specific, or secret-bearing files never belong in the repo.
# The runtime reads all of these from ~/.config/cc-container/ instead.
config.sh
mcp.env
mcp-servers.json
*.local.*

# Editor, OS and tooling artefacts. .idea/ in particular carries local paths and
# IDE history, which has no business in a public repo.
.idea/
.DS_Store
__pycache__/
*.pyc
.claude/worktrees/
